# Server Configuration
PORT=8000
# Set to True for uvicorn's --reload flag (useful for local dev NOT in Docker)
RELOAD=False

# LLM Configuration
# Choose one: "stub", "openai", "anthropic"
LLM_PROVIDER="stub"

# Provide API key ONLY if using a real provider (openai or anthropic)
# LLM_API_KEY="your_openai_or_anthropic_api_key_here"

# Feature Flags / Limits
MAX_TEXT_LENGTH=5000

# Caching (Stretch Goal)
CACHE_ENABLED=False # Set to True to enable in-memory caching
CACHE_TTL_SECONDS=300 # Cache entry lifetime in seconds (e.g., 300 = 5 minutes)
CACHE_MAX_SIZE=1024 # Maximum number of items in the cache
